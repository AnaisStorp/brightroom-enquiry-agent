# Copy to .env and fill in. Never commit .env.

# openrouter | openai | anthropic
LLM_PROVIDER=openrouter

# Model id as the chosen provider names it
#   openrouter: anthropic/claude-sonnet-5.5
#   anthropic:  claude-sonnet-5-5
MODEL=anthropic/claude-sonnet-5.5

# Only the key for the chosen provider is needed
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: override the cost-estimate constants (USD per million tokens)
# PRICE_PER_MTOK_INPUT_USD=2.00
# PRICE_PER_MTOK_OUTPUT_USD=10.00
